# Shopify app credentials (from the Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_products,read_customers
SHOPIFY_APP_URL=

# Database (SQLite for local dev; swap for Postgres in production)
DATABASE_URL="file:./dev.sqlite"

# Secrets vault (placeholder — real deployment should use a managed
# secrets manager, e.g. AWS Secrets Manager / HashiCorp Vault, not
# an env var, for connector OAuth tokens. See app/lib/connectors/README.md)
CONNECTOR_SECRETS_PROVIDER=local-dev
